    99.99847
    rel_uw_b100
    0.00
    99.99847

    FORMAT "%8.5"
    
    /begin IF_DATA ASAP1B_CCP DP_BLOB 0x00 0x5CE5C4 410 /end IF_DATA
    /begin IF_DATA ETK  DP_BLOB 0x90E5C4  0x19A  /end IF_DATA 
    /begin IF_DATA ASAP1B_KWP2000 DP_BLOB 0x5CE5C4 0x19A /end IF_DATA 

    /begin AXIS_DESCR

        STD_AXIS
        nmot_w
        nmot_uw_q0p25
        16
        0.00
        16383.75

        FORMAT "%8.2"
        DEPOSIT ABSOLUTE

    /end AXIS_DESCR

    /begin AXIS_DESCR

        STD_AXIS
        rl_w
        rel_uw_q0p0234
        11
        0.00
        1535.977

        FORMAT "%8.3"
        DEPOSIT ABSOLUTE

    /end AXIS_DESCR

/end CHARACTERISTIC


#!/usr/bin/env python3
"""
ME7 Knowledge Graph — causal reasoning about ECU calibration using Kùzu graph DB.

Models map dependencies, signal chains, tune version lineage, and diagnostic
causal chains from the ME7 Funktionsrahmen. Enables queries like:
  - "What maps are downstream of KFMIOP?"
  - "What could cause knock at 5500 RPM?"
  - "What changed between v2.7.4 and v3.2.1?"
  - "What does water injection affect?"

Usage:
  bin/me7-knowledge-graph init --db <path>
      Initialize graph with ME7 Funktionsrahmen knowledge (map deps, signal chains)

  bin/me7-knowledge-graph add-tunes --db <path> --tunes <dir> --xdf <xdf>
      Index tune versions and record map-level diffs as CHANGED_MAP edges

  bin/me7-knowledge-graph diagnose --db <path> --symptom <type:rpm:load> \\
      --cause <description> --requires-change <map>
      Record a diagnostic finding as a causal chain

  bin/me7-knowledge-graph query --db <path> <cypher-query>
      Run a raw Cypher query against the graph

  bin/me7-knowledge-graph show --db <path> [--map <name>] [--version <ver>]
      Show graph neighborhood around a map or tune version

  bin/me7-knowledge-graph downstream --db <path> --map <name> [--depth <n>]
      Show all maps downstream of a given map (affected by changes)

  bin/me7-knowledge-graph upstream --db <path> --map <name> [--depth <n>]
      Show all maps upstream of a given map (that feed into it)

  bin/me7-knowledge-graph chain --db <path>
      Show the full ME7 4-link boost control signal chain
"""

import argparse
import hashlib
import json
import os
import re
import struct
import sys
import xml.etree.ElementTree as ET
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Optional, Tuple

try:
    import kuzu
except ImportError:
    print("ERROR: kuzu package not installed. Run: pip install kuzu")
    sys.exit(1)



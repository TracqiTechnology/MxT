#!/usr/bin/env python3
"""
ME7 Log Ingest — loads ME7Logger CSV time-series data into DuckDB for analytics.

Creates a columnar analytics database from ME7Logger CSV files, enabling:
- Window-function queries (rolling knock averages, boost ramps)
- Cross-log aggregation (density altitude vs knock correlation)
- WOT event detection and indexing
- SAE-correctable power estimation

Usage:
  bin/me7-log-ingest --logs <directory> --db <tuning.duckdb> [options]

Options:
  --incremental    Only ingest new/changed files (track by file hash)
  --verbose        Show per-file progress
  --stats          Print summary statistics after ingest
  --help           This message

Examples:
  # Full ingest of all logs
  bin/me7-log-ingest \\
    --logs ~/Dropbox/S4/ME7Logger/logs/ \\
    --db tuning.duckdb

  # Incremental update (only new files)
  bin/me7-log-ingest \\
    --logs ~/Dropbox/S4/ME7Logger/logs/ \\
    --db tuning.duckdb --incremental

  # After ingest, query with DuckDB:
  python3 -c "
  import duckdb
  db = duckdb.connect('tuning.duckdb')
  # Knock vs density altitude
  print(db.sql('''
    SELECT ROUND(density_altitude_ft / 1000) * 1000 AS da_bin,
           AVG(knock_total) AS avg_knock, COUNT(*) AS n
    FROM wot_events GROUP BY da_bin ORDER BY da_bin
  ''').df())
  "
"""

import argparse
import csv
import hashlib
import math
import os
import re
import sys
from datetime import datetime
from pathlib import Path

try:
    import duckdb
except ImportError:
    print("Error: duckdb package required. Install with: pip install duckdb", file=sys.stderr)
    sys.exit(1)


# ── ME7Logger column name mappings ──────────────────────────────────────


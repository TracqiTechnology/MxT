#!/usr/bin/env python3
"""
ME7 Safety Validator — prevents dangerous calibration values from reaching the ECU.

Three modes:
  1. Map validation:  Check proposed map values against per-map constraints
  2. Cross-map coherence: Verify relationships between maps (KFMIOP↔KFMIRL, KFZWOP≥KFZW)
  3. Log pre-flight: Validate log data quality before running the optimizer

Usage:
  bin/me7-safety-check --xdf <xdf> --bin <bin> [options]

  # Validate a binary against safety rules
  bin/me7-safety-check --xdf <xdf> --bin <bin> --validate

  # Check cross-map coherence
  bin/me7-safety-check --xdf <xdf> --bin <bin> --coherence

  # Validate proposed changes (JSON) against current binary
  bin/me7-safety-check --xdf <xdf> --bin <bin> --changes <changes.json>

  # Validate proposed binary against reference (delta limits)
  bin/me7-safety-check --xdf <xdf> --bin <bin> --reference <ref.bin>

  # Log data quality pre-flight
  bin/me7-safety-check --logs <dir> --preflight

  # Full validation suite
  bin/me7-safety-check --xdf <xdf> --bin <bin> --reference <ref.bin> --all

  # JSON output for agent consumption
  bin/me7-safety-check ... --format json

Options:
  --strict        Treat warnings as errors (exit code 1)
  --format json   Machine-readable output
  --verbose       Show per-cell details
  --help          This message
"""

import argparse
import csv
import json
import math
import os
import re
import struct
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Dict, List, Optional, Tuple


# ── Safety Rule Definitions ──────────────────────────────────────────────────
#
# Rules are data, not code — reviewable, versionable, auditable.
# Each map can have: absolute bounds, per-cell constraints, delta limits,
# monotonicity requirements, and cross-map relationships.

